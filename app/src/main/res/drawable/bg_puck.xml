<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Choosing where the bubble lives. -->
    <item android:state_activated="true">
        <shape android:shape="oval">
            <solid android:color="#F2003544" />
            <stroke
                android:width="2dp"
                android:color="#FF00E5FF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#F2202832" />
            <stroke
                android:width="2dp"
                android:color="#B300E5FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#F2161A1F" />
            <stroke
                android:width="1dp"
                android:color="#5900E5FF" />
        </shape>
    </item>
</selector>
